@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Usuario de mostrador" as Mostrador
actor "Cocina" as Cocina

rectangle "Sistema de Pedidos" {
  usecase "Registrar pedido" as UC_Registrar
  usecase "Modificar pedido" as UC_Modificar
  usecase "Agregar o quitar\nproductos" as UC_Productos
  usecase "Modificar\npersonalizaciones" as UC_Personalizaciones
  usecase "Calcular total\ndel pedido" as UC_Total
  usecase "Enviar pedido\na cocina" as UC_EnviarCocina

  usecase "Consultar pedidos\nactivos" as UC_Consultar
  usecase "Cambiar estado\ndel pedido" as UC_Estado
  usecase "Cancelar pedido" as UC_Cancelar
  usecase "Marcar pedido\ncomo prioritario" as UC_Priorizar

  usecase "Identificar pedido\npara retiro" as UC_Identificar
  usecase "Registrar entrega\ndel pedido" as UC_Entrega
  usecase "Cobrar cuenta" as UC_Cobrar
  usecase "Registrar pago" as UC_Pago
  usecase "Preparar pedido" as UC_Preparar
}

Mostrador --> UC_Registrar
Mostrador --> UC_Modificar
Mostrador --> UC_Consultar
Mostrador --> UC_Cancelar
Mostrador --> UC_Priorizar
Mostrador --> UC_Identificar
Mostrador --> UC_Entrega
Mostrador --> UC_Cobrar

Cocina --> UC_Preparar
Cocina --> UC_Estado
Cocina --> UC_Consultar

UC_Registrar .> UC_Total : <<include>>
UC_Registrar .> UC_EnviarCocina : <<include>>
UC_Modificar .> UC_Productos : <<include>>
UC_Modificar .> UC_Personalizaciones : <<include>>
UC_Modificar .> UC_Total : <<include>>
UC_Cobrar .> UC_Identificar : <<include>>
UC_Cobrar .> UC_Total : <<include>>
UC_Cobrar .> UC_Pago : <<include>>
UC_Entrega .> UC_Identificar : <<include>>
UC_Preparar .> UC_Estado : <<include>>
UC_Entrega .> UC_Estado : <<include>>
UC_Cancelar .> UC_Estado : <<include>>
UC_Priorizar .> UC_Consultar : <<include>>

note right of UC_Modificar
  Solo permitido mientras el pedido
  se encuentre en estado recibido.
  En preparación, listo, entregado
  y cancelado queda bloqueado.
end note

note right of UC_Productos
  La adición o eliminación de
  productos solo es válida
  en estado recibido.
end note

note right of UC_Personalizaciones
  La modificación de
  personalizaciones solo es válida
  en estado recibido.
end note

note right of UC_Cancelar
  Solo permitido en estado
  recibido o en preparación.
end note

note right of UC_Entrega
  El pedido debe estar
  listo para entregar.
end note

note right of UC_Cobrar
  Se registra el pago y el pedido
  conserva su estado actual
  (recibido, en preparación, listo,
  entregado o cancelado).
end note

@enduml
